# Copy to .env and add your key. Without a key the API runs in demo mode with canned answers.
ANTHROPIC_API_KEY=
# Main model for chat, explanations and look-ups
ANTHROPIC_MODEL=claude-sonnet-5-5
# Fast model for definitions
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
PORT=8787

# Accounts and sync (optional). Without these the app saves on this device only.
# From your Supabase project: Settings → API. Run supabase/migrations/*.sql first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 on a hosted server to refuse Explain/Ask/Draft from anyone who isn't signed in.
REQUIRE_SIGN_IN=
