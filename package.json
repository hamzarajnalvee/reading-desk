{
  "name": "reading-desk",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Reading Desk: grow a tree of understanding from anything you read. Branch from any sentence into sources, definitions, notes and explanations, slide between them as cards, and zoom out to the map.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "@supabase/supabase-js": "^2.118.0",
    "@xyflow/react": "^12.12.1",
    "d3-hierarchy": "^3.1.3",
    "dotenv": "^18.0.9",
    "express": "^4.22.3",
    "idb-keyval": "^6.3.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.66.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/express": "^4.17.25",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
